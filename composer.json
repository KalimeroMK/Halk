{
    "name": "kalimeromk/halkbank-payment",
    "description": "A Laravel package for handling HalkBank payments.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel"
    ],
    "authors": [
        {
            "name": "Zorab Shefot Bogoevski",
            "email": "zbogoevski@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Kalimeromk\\HalkbankPayment\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kalimeromk\\HalkbankPayment\\HalkBankPaymentServiceProvider"
            ]
        }
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Kalimeromk\\HalkbankPayment\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
